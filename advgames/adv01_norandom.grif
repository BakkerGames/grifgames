// adv01_norandom.grif - GRIF format
background.0
	@if @rand(75) @or @istrue(@get(value.norandom)) @then
		@if @carry(8) @and @not @carry(19) @then
			@comment("FISH ESCAPE")
			@msg(message.67)
			@sendto(8,10)
		@endif
	@endif
background.1
	@if @rand(10) @or @istrue(@get(value.norandom)) @then
		@if @carry(21) @and @not @isroom(33) @then
			@comment("DIE BITES")
			@msg(message.13)
			@set(value.flag.dark,false)
			@goto(33)
		@endif
	@endif
background.2
	@if @rand(10) @or @istrue(@get(value.norandom)) @then
		@if @carry(20) @and @not @carry(7) @then
			@comment("BITE INFECT")
			@msg(message.12)
			@take(21)
			@sendto(20,0)
		@endif
	@endif
background.3
	@if @rand(8) @and @isfalse(@get(value.norandom)) @then
		@if @herecarry(26) @and @isfalse(@get(value.flag.17)) @then
			@comment("BEES DIE")
			@msg(message.17)
			@swap(item.26.location,item.13.location)
		@endif
	@endif
background.6
	@if @rand(5) @and @isfalse(@get(value.norandom)) @then
		@if @carry(7) @and @not @carry(12) @then
			@comment("MUD OFF")
			@msg(message.40)
			@sendto(7,1)
		@endif
	@endif
background.7
	@if @rand(8) @and @isfalse(@get(value.norandom)) @then
		@if @not @carry(20) @and @not @carry(21) @and @here(42) @and @not @carry(7) @then
			@comment("BIT CHIG")
			@take(20)
			@msg(message.45)
		@endif
	@endif
background.8
	@if @rand(8) @and @isfalse(@get(value.norandom)) @then
		@if @here(24) @and @not @herecarry(7) @then
			@comment("BEE STING")
			@msg(message.15)
			@set(value.flag.dark,false)
			@goto(33)
		@endif
	@endif
background.10
	@if @rand(50) @or @istrue(@get(value.norandom)) @then
		@if @carry(8) @and @not @carry(12) @then
			@comment("FISH DIE")
			@msg(message.48)
			@sendto(8,0)
			@take(55)
		@endif
	@endif
background.12
	@if @rand(30) @or @istrue(@get(value.norandom)) @then
		@if @carry(42) @and @not @carry(21) @and @not @carry(20) @and @not @carry(7) @then
			@comment("GET CHIG")
			@take(20)
			@msg(message.45)
		@endif
	@endif
background.13
	@if @rand(50) @or @istrue(@get(value.norandom)) @then
		@if @here(27) @and @herecarry(7) @then
			@comment("MUD DRAGON")
			@msg(message.4)
			@set(value.flag.dark,false)
			@goto(33)
		@endif
	@endif
modmsg.norandom
	The "norandom" mod is installed. Random events will now always happen or never happen.
value.norandom
	true
